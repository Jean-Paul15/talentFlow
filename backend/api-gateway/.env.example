# Configuration environnement - API Gateway NestJS

# Base de données PostgreSQL
DATABASE_URL=postgresql://talentflow:CHANGEME@localhost:5432/talentflow_app

# JWT
JWT_SECRET=CHANGEME_GENERATE_WITH_openssl_rand_-base64_32
JWT_EXPIRATION=7d

# Services externes
SEARCH_ENGINE_URL=http://localhost:8003
RECOMMENDATION_URL=http://localhost:8001
CV_INGESTION_OCR_ENABLED=true
CV_INGESTION_QUALITY_THRESHOLD=0.42
CV_INGESTION_OCR_MAX_PAGES=10
CV_INGESTION_OCR_LANG=fra+eng
CV_INGESTION_INTERNAL_TOKEN=CHANGEME_INTERNAL_TOKEN
RUNTIME_INTERNAL_TOKEN=CHANGEME_INTERNAL_TOKEN

# Redis Cache
REDIS_URL=redis://localhost:6379

# NestJS
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
GRAPHQL_PATH=/graphql
FRONTEND_URL=https://app.example.com
API_PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com,https://app.example.com,https://api.example.com

# Elasticsearch
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=jobs

# MongoDB (pour historique brut)
MONGODB_URL=mongodb://localhost:27017/talentflow
