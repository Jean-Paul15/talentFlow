// Prisma schema - Base de donnees PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Utilisateurs
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  
  // Metadata
  phone     String?
  location  String?
  headline  String?
  
  // Preferences
  preferredRoles    String[]  @default([])
  preferredCountry  String?
  
  // Relations
  favorites         Favorite[]
  analysisHistory   AnalysisHistory[]
  recommendationHistory RecommendationHistory[]
  cvFiles           CVFile[]
  cvAnalysisJobs    CvAnalysisJob[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CvAnalysisJob {
  id          String   @id @default(cuid())
  userId      String
  status      String   @default("QUEUED")
  stage       String   @default("QUEUED")
  progress    Int      @default(0)
  inputType   String
  fileName    String?
  error       String?
  inputPayload Json?
  extractionMeta Json?
  resultPayload Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model RecommendationHistory {
  id                String   @id @default(cuid())
  userId            String
  cvTextPreview     String
  fileName          String?
  queryUsed         String   @default("")
  locationFilter    String?
  contractTypeFilter String?
  assistantMessage  String
  llmUsed           Boolean  @default(false)
  llmProvider       String?
  llmModel          String?
  llmError          String?
  llmStatus         String?  @default("fallback_used")
  totalResults      Int      @default(0)
  assistantStructured Json?
  cvAnalysis        Json?
  jobsSnapshot      Json
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Favoris (offres sauvegardees)
model Favorite {
  id      String @id @default(cuid())
  userId  String
  jobId   String
  
  // Cache de l'offre
  title       String
  company     String
  description String
  location    String
  contractType String?
  salary      String?
  sourceName  String?
  sourceUrl   String?
  postedDate  String?
  score       Float?
  
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@unique([userId, jobId])
  @@index([userId])
}

// CV stockes (cache)
model CVFile {
  id      String @id @default(cuid())
  userId  String
  
  // Metadata
  fileName  String
  fileSize  Int
  uploadedAt DateTime @default(now())
  
  // Analyse (cache)
  skills          String[]
  experienceYears Int?
  educationLevel  String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysisHistory AnalysisHistory[]
  
  @@index([userId])
}

// Historique des analyses
model AnalysisHistory {
  id        String @id @default(cuid())
  userId    String
  cvFileId  String
  jobId     String
  
  // Resultats
  score         Float
  scoreLabel    String
  semanticScore Float
  skillsScore   Float
  
  // Feedback LLM
  gapAnalysis   String?
  recommendations String?
  cvSuggestions String?
  
  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvFile  CVFile @relation(fields: [cvFileId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([cvFileId])
  @@index([jobId])
}

// Session JWT (optionnel, pour revocation)
model JwtBlacklist {
  id    String @id @default(cuid())
  token String @unique
  
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([expiresAt])
}
