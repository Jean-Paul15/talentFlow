# TalentFlow - Variables d'Environnement (PRODUCTION)
# ⚠️ NE JAMAIS commit le fichier .env réel!

# === SÉCURITÉ ===
JWT_SECRET=CHANGEME_GENERATE_WITH_openssl_rand_-base64_32
MINIO_ROOT_USER=CHANGEME
MINIO_ROOT_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_-base64_32
POSTGRES_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_-base64_32

# === API KEYS ===
HUGGINGFACE_API_KEY=CHANGEME

# === API GATEWAY ===
API_GATEWAY_PORT=3000
NODE_ENV=production

# === BASES DE DONNÉES ===
DATABASE_URL=postgresql://talentflow:${POSTGRES_PASSWORD}@postgres:5432/talentflow
REDIS_URL=redis://redis:6379
MONGODB_URI=mongodb://mongodb:27017/talentflow

# === SERVICES ===
JOB_SOURCING_PORT=8000
DATA_CLEANING_PORT=8002
SEARCH_ENGINE_PORT=8003
RECOMMENDATION_PORT=8001

# === STORAGE ===
MINIO_HOST=minio:9000

# === ORCHESTRATION (Airflow) ===
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW_HOME=/opt/airflow

# === MONITORING ===
GRAFANA_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_-base64_32
AIRFLOW_URL=http://localhost:8080

MINIO_BUCKET_BRONZE=jobs-bronze
MINIO_BUCKET_SILVER=jobs-silver

# === LLM ===
LLM_PROVIDER=gemini
LLM_PROVIDER_ORDER=gemini,deepseek
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
GEMINI_API_KEY=CHANGEME
GEMINI_API_KEY_FALLBACK=CHANGEME
# Optionnel: liste complete si plus de 2 cles.
# Important: plusieurs cles sur le meme projet Google n'augmentent pas le quota.
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRIORITY=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_SECONDS=1.0
DEEPSEEK_ENABLED=true
DEEPSEEK_API_KEY=CHANGEME
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
DEEPSEEK_TIMEOUT_SECONDS=45
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_OUTPUT_TOKENS_CHAT=700
DEEPSEEK_MAX_OUTPUT_TOKENS_REASONER=1600
DEEPSEEK_DAILY_TOKEN_BUDGET=500000
DEEPSEEK_DAILY_COST_BUDGET_USD=5.0
DEEPSEEK_REASONER_COMPLEXITY_THRESHOLD=1.0
DEEPSEEK_REASONER_MAX_SHARE=0.20
DEEPSEEK_QUEUE_CONCURRENCY=4
DEEPSEEK_QUEUE_MAX_SIZE=32
DEEPSEEK_QUEUE_WAIT_MS=900
DEEPSEEK_RPM_GLOBAL=120
DEEPSEEK_RPM_PER_IP=20
DEEPSEEK_INPUT_COST_PER_MILLION_CACHE_MISS=0.28
DEEPSEEK_OUTPUT_COST_PER_MILLION=0.42
LLM_TEMPERATURE=0.2
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
LLM_REPAIR_CACHE_TTL_SECONDS=300
LLM_PROMPT_TEMPLATE_VERSION=v2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=60
LLM_DECISION_MIN_JOB_COUNT=2
LLM_DECISION_MIN_TOP_SCORE=0.62
LLM_DECISION_MIN_SCORE_GAP=0.04
LLM_DECISION_MISSING_RATIO_TRIGGER=0.35
LLM_DECISION_OFFER_MIN_MISSING_SKILLS=2
LLM_DECISION_OFFER_SUMMARY_MIN_CHARS=500
SEARCH_ENGINE_USE_BY_VECTOR=true
CV_INGESTION_OCR_ENABLED=true
CV_INGESTION_QUALITY_THRESHOLD=0.42
CV_INGESTION_OCR_MAX_PAGES=10
CV_INGESTION_OCR_LANG=fra+eng
CV_INGESTION_INTERNAL_TOKEN=CHANGEME_INTERNAL_TOKEN
RUNTIME_INTERNAL_TOKEN=CHANGEME_INTERNAL_TOKEN

# === GUARD AGENTS / ALERTING (Resend) ===
GUARD_API_BASE_URL=https://api.example.com
GUARD_STATE_DIR=/opt/talentflow-admin/state/guard
GUARD_ALERT_TO=adoglijeanpaul@gmail.com
GUARD_ALERT_FROM=TalentFlow Alerts <alerts@example.com>
RESEND_API_KEY=

# === DATA CLEANING LLM ===
DATA_CLEANING_LLM_PROVIDER=mistral
DATA_CLEANING_LLM_ENABLED=false
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=45
MISTRAL_MAX_RETRIES=2
MISTRAL_RETRY_BASE_SECONDS=1.0
DELETE_BRONZE_AFTER_ARCHIVE=true
LOCAL_BOARD_STALE_TTL_DAYS=45
API_REMOTE_STALE_TTL_DAYS=30
FAST_FEED_STALE_TTL_DAYS=21

# === SEARCH QDRANT HYBRID + RERANK POLICY ===
QDRANT_HYBRID_ENABLED=false
QDRANT_ENABLE_SPARSE=false
QDRANT_RRF_K=60
SEARCH_EXCLUDE_EXPIRED=true
SEARCH_STALE_PENALTY=0.45
SEARCH_MIN_QUALITY_USER_FACING=0.20
SEARCH_MIN_TITLE_CONFIDENCE=0.20
SEARCH_TEXT_NOISE_PENALTY=0.78
RECOMMENDATION_MIN_MEANINGFUL_SCORE=0.52
RECOMMENDATION_MAX_SCORE_DROP_FROM_TOP=0.22
RECOMMENDATION_SINGLE_STRONG_MATCH_SCORE=0.82
RECOMMENDATION_DEEPSEEK_AMBIGUOUS_FIRST_ENABLED=true
RECOMMENDATION_DEEPSEEK_BORDERLINE_DELTA=0.06
RECOMMENDATION_POLICY_VERSION=score_v5
RERANK_ENABLED=false
RERANK_POLICY_MODE=auto
RERANK_POLICY_TARGET_K=10
RERANK_POLICY_MIN_CASES=3
RERANK_POLICY_ENABLE_NDCG_GAIN_ABS=0.01
RERANK_POLICY_ENABLE_MRR_GAIN_ABS=0.005
RERANK_POLICY_DISABLE_NDCG_GAIN_ABS=-0.01
RERANK_POLICY_DISABLE_MRR_GAIN_ABS=-0.005
RERANK_POLICY_ENABLE_WINDOWS=2
RERANK_POLICY_DISABLE_WINDOWS=1

# === LLM FALLBACK (Haute disponibilité) ===
LLM_ENABLE_FALLBACK=true
LLM_FALLBACK_PROVIDER=gemini

# === CORS (production - restreindre!) ===
ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com,https://app.example.com,https://api.example.com
API_GATEWAY_HOST=0.0.0.0
GRAPHQL_PATH=/graphql
FRONTEND_URL=https://app.example.com
API_PUBLIC_BASE_URL=http://localhost:3000
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# === RATE LIMITING ===
RATE_LIMIT_ANALYZE=50
RATE_LIMIT_LLM=30
RATE_LIMIT_SEARCH=200

# Clés optionnelles (valeurs factices)
JSEARCH_API_KEY=CHANGEME
RESEND_API_KEY=CHANGEME
MISTRAL_API_KEY=CHANGEME
QDRANT_API_KEY=CHANGEME
RUNTIME_INTERNAL_TOKEN=CHANGEME
CV_INGESTION_INTERNAL_TOKEN=CHANGEME
