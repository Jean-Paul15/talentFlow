# Configuration environnement - Data Cleaning Service
# Copier vers .env et remplir les valeurs

# MinIO (Bronze Storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGEME
MINIO_SECRET_KEY=CHANGEME
MINIO_BUCKET_RAW=talentflow-bronze

# MongoDB (Silver Storage)
MONGODB_URI=mongodb://localhost:27017/talentflow_silver
MONGODB_DATABASE=talentflow_silver
MONGODB_COLLECTION=jobs

# Data-cleaning LLM policy
DATA_CLEANING_LLM_PROVIDER=mistral
DATA_CLEANING_LLM_ENABLED=false
DATA_CLEANING_LLM_FALLBACK_MISTRAL_ENABLED=true
DATA_CLEANING_LLM_TITLE_MAX_CHARS=220
DATA_CLEANING_LLM_DESC_MAX_CHARS=900

# Mistral cloud (principal)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_SECONDS=45
MISTRAL_MAX_RETRIES=2
MISTRAL_RETRY_BASE_SECONDS=1.0

# Qwen local (batch)
QWEN_LOCAL_BASE_URL=http://qwen-local:11434/v1
QWEN_LOCAL_MODEL=qwen2.5:7b-instruct
QWEN_LOCAL_TIMEOUT_SECONDS=45
QWEN_LOCAL_MAX_RETRIES=1
QWEN_LOCAL_RETRY_BASE_SECONDS=1.0
QWEN_LOCAL_NUM_CTX=2048
QWEN_LOCAL_TOP_P=0.9
QWEN_LOCAL_REPEAT_PENALTY=1.05

DELETE_BRONZE_AFTER_ARCHIVE=false
LOCAL_BOARD_STALE_TTL_DAYS=45
API_REMOTE_STALE_TTL_DAYS=30
FAST_FEED_STALE_TTL_DAYS=21

# Processing
BATCH_SIZE=50
MAX_WORKERS=4
LLM_MAX_TOKENS=180
LLM_TEMPERATURE=0.1
