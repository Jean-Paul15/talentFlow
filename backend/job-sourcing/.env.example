# ===================================================================
# TalentFlow - Configuration centralisee
# ===================================================================
# Copier ce fichier en .env et remplir les valeurs.
# Seules les cles API sont necessaires.
# Les autres valeurs ont des defaults fonctionnels en local.
# ===================================================================


# -------------------------------------------------------------------
# INFRASTRUCTURE (configures par Docker, pas besoin de toucher)
# -------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGEME
MINIO_SECRET_KEY=CHANGEME
MINIO_BUCKET_RAW=talentflow-bronze
MINIO_SECURE=false


# -------------------------------------------------------------------
# APIs GRATUITES - COLLECTE D'OFFRES
# Remplir au moins JSEARCH_API_KEY pour activer la collecte API
# -------------------------------------------------------------------

# JSearch (RapidAPI) - Google for Jobs
# Inscription gratuite : https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Plan BASIC : 200 requetes/mois, sans carte bancaire
JSEARCH_API_KEY=

# Adzuna - Agregateur international
# Inscription gratuite : https://developer.adzuna.com/signup
# Pas de limite stricte
ADZUNA_APP_ID=
ADZUNA_APP_KEY=


# -------------------------------------------------------------------
# LLM - EXTRACTION INTELLIGENTE (optionnel)
# Mode officiel: Gemini uniquement avec fallback par seconde cle.
# Si Gemini est indisponible, l'enrichissement LLM est saute.
# -------------------------------------------------------------------

# Activer le module LLM (false par defaut)
LLM_ENABLED=false
LLM_PROVIDER=gemini

# Cles Gemini
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
# Optionnel: liste CSV si vous avez plusieurs cles
GEMINI_API_KEYS=

# Configuration Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRIORITY=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Parametres de generation
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.1


# -------------------------------------------------------------------
# CONFIGURATION DU SCRAPING
# -------------------------------------------------------------------
SCRAPING_DELAY=2
SCRAPING_CONCURRENT_REQUESTS=4
SCRAPY_DROP_NON_JOB_ITEMS=true
SCRAPY_SEMANTIC_DEDUP_ENABLED=true
# true = uniquement spiders avec dossier dedie (desactive deep_crawler)
DEDICATED_SPIDERS_ONLY=true
LOG_LEVEL=INFO

# Sources globales (anti-blocage: pagination limitee et rythme reduit)
INDEED_MAX_PAGES=3
GLASSDOOR_MAX_PAGES=2
MONSTER_MAX_PAGES=2
INDEED_DOWNLOAD_DELAY=3
GLASSDOOR_DOWNLOAD_DELAY=4
MONSTER_DOWNLOAD_DELAY=5

# -------------------------------------------------------------------
# OPTIONAL - RENDU JAVASCRIPT (Scrapy + Playwright) pour sites SPA
# Ex: Wiijob listing (pagination client-side)
# -------------------------------------------------------------------
SCRAPY_ENABLE_PLAYWRIGHT=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER_TYPE=chromium
PLAYWRIGHT_NAV_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_CONTEXTS=2
PLAYWRIGHT_MAX_PAGES_PER_CONTEXT=4

# Wiijob: essais supplementaires pour discovery des URLs
WIIJOB_USE_PLAYWRIGHT=false
WIIJOB_TRY_SITEMAP=true

# Monster: detail pages via Playwright (SPA/React)
MONSTER_FETCH_DETAILS=true
MONSTER_USE_PLAYWRIGHT=false
MONSTER_DETAIL_USE_PLAYWRIGHT=false

# -------------------------------------------------------------------
# ALERTING QA AUTOMATIQUE (Telegram / Email)
# Le check est appele par l'API job-sourcing et le DAG Airflow.
# -------------------------------------------------------------------
QA_ALERT_CHANNELS=telegram,email
QA_ALERT_MIN_ITEMS=5
QA_ALERT_DATE_RATE_MIN=0.50
QA_ALERT_APPLY_RATE_MIN=0.50
QA_ALERT_DESCRIPTION_RATE_MIN=0.80
QA_ALERT_SUCCESS_RATE_MIN=0.70
QA_ALERT_COOLDOWN_MINUTES=360

# Telegram bot (optionnel)
QA_ALERT_TELEGRAM_BOT_TOKEN=
QA_ALERT_TELEGRAM_CHAT_ID=

# Email SMTP (optionnel)
QA_ALERT_EMAIL_TO=
QA_ALERT_EMAIL_FROM=
QA_ALERT_SMTP_HOST=
QA_ALERT_SMTP_PORT=587
QA_ALERT_SMTP_USER=
QA_ALERT_SMTP_PASSWORD=
QA_ALERT_SMTP_STARTTLS=true
