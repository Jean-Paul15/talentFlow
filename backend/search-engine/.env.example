# Search Engine - Variables d'environnement

# Backend de recherche
SEARCH_BACKEND=qdrant
SEARCH_INDEX_NAME=talentflow_jobs
SEARCH_INDEX_INCREMENTAL_ENABLED=true
SEARCH_DEFAULT_LIMIT=20
SEARCH_LEXICAL_WEIGHT=0.3
SEARCH_SEMANTIC_WEIGHT=0.7
SEARCH_KNN_K=50
SEARCH_KNN_NUM_CANDIDATES=100

# Qdrant (si SEARCH_BACKEND=qdrant)
# Local:
QDRANT_URL=http://localhost:6333
# Cloud (exemple):
# QDRANT_URL=https://xxxxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=talentflow_jobs
# Dense-only par defaut pour le user-facing (plus rapide et stable)
QDRANT_HYBRID_ENABLED=false
QDRANT_ENABLE_SPARSE=false
QDRANT_RRF_K=60
QDRANT_DENSE_LIMIT=50
QDRANT_LEXICAL_LIMIT=50
SEARCH_EXCLUDE_EXPIRED=true
SEARCH_STALE_PENALTY=0.72
SEARCH_MIN_QUALITY_USER_FACING=0.20
SEARCH_MIN_TITLE_CONFIDENCE=0.20
# Optionnel si fastembed est installe et collection sparse indexee
QDRANT_SPARSE_MODEL=Qdrant/bm25

# MongoDB (source des offres)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=talentflow
MONGODB_COLLECTION=jobs

# Hugging Face (optionnel, pour telecharger modeles prives)
HUGGINGFACE_API_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu

# Reranker (cross-encoder) - optionnel
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_K=50
RERANK_MAX_CANDIDATES=100
RERANK_BATCH_SIZE=16
RERANK_BLEND_ALPHA=0.75
RERANK_MIN_QUERY_TOKENS=2
RERANK_MAX_TEXT_CHARS=12000
RERANK_MIN_RAW_SCORE_SPREAD=0.05
# Politique auto rerank (mode auto bascule ON/OFF selon gains evaluate-batch)
RERANK_POLICY_MODE=auto
RERANK_POLICY_STATE_FILE=/tmp/talentflow_rerank_policy.json
RERANK_POLICY_TARGET_K=10
RERANK_POLICY_MIN_CASES=3
RERANK_POLICY_ENABLE_NDCG_GAIN_ABS=0.01
RERANK_POLICY_ENABLE_MRR_GAIN_ABS=0.005
RERANK_POLICY_DISABLE_NDCG_GAIN_ABS=-0.01
RERANK_POLICY_DISABLE_MRR_GAIN_ABS=-0.005
RERANK_POLICY_ENABLE_WINDOWS=2
RERANK_POLICY_DISABLE_WINDOWS=1
RERANK_POLICY_MAX_HISTORY=100

# API
DEBUG=false
LOG_LEVEL=INFO
